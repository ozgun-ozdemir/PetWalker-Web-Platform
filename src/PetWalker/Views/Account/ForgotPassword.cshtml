@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<section class="photo-page bg-signin">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row">
            <div class="col-12 d-flex justify-content-center">
                <form asp-action="ForgotPassword" method="post" class="glass-dark auth-form signin mt-lg-5">
                    <h1 class="h3 mb-3">Şifre Sıfırlama</h1>
                    <p class="small">Sistemde kayıtlı e-posta adresini gir. Sana yeni şifre gönderelim.</p>
                    <div class="form-floating mb-3 text-dark">
                        <input asp-for="Email" class="form-control" placeholder="E-posta" autocomplete="email" required />
                        <label asp-for="Email"></label>
                    </div>
                    <span asp-validation-for="Email" class="text-warning small"></span>
                    <button type="submit" class="btn btn-brand w-100">Yeni Şifre Gönder</button>
                    <div class="small text-center mt-3"><a asp-action="SignIn">Girişe dön</a></div>
                </form>
            </div>
        </div>
    </div>
</section>
