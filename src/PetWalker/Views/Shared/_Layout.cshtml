@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a is null || action == a) ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
          integrity="sha384-qrALq7+6jBOZIQsNnT6xGkMDru64qD6uTlDra39xrt2SoXl4pO3FX6Roz/RpR/BS" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="" /> PetWalker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-lg-1">
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Walkers")" asp-controller="Walkers" asp-action="Index">Gezdirici Ara</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Walks")" asp-controller="Walks" asp-action="Index">Yürüyüşlerim</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Chat")" asp-controller="Chat" asp-action="Index">Mesajlar</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home", "About")" asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home", "Contact")" asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    </ul>
                    <ul class="navbar-nav gap-lg-1">
                        @if (signedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Account", "Profile")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user"></i> @User.Identity!.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user fa-fw"></i> Profilim</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="SignOut" method="post">
                                            <button type="submit" class="dropdown-item"><i class="fa-solid fa-right-from-bracket fa-fw"></i> Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account", "SignIn")" asp-controller="Account" asp-action="SignIn">Giriş Yap</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Account", "SignUp")" asp-controller="Account" asp-action="SignUp">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="toast-area">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show shadow mx-3" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow mx-3" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>
        }
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer pt-5">
        <div class="container-fluid px-4 px-lg-5">
            <div class="row g-4">
                <div class="col-sm-6 col-lg">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo.svg" alt="" class="footer-logo" />
                        <span class="h4 mb-0 text-white">PetWalker</span>
                    </a>
                    <p class="mb-0">Patili dostunuza güvenilir bir yürüyüş arkadaşı.</p>
                </div>
                <div class="col-sm-6 col-lg">
                    <h5>Menü</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg">
                    <h5>İşlemler</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Account" asp-action="Profile">Profilim</a></li>
                        <li><a asp-controller="Walkers" asp-action="Index">Gezdirici Ara</a></li>
                        <li><a asp-controller="Walks" asp-action="Index">Yürüyüşlerim</a></li>
                        <li><a asp-controller="Chat" asp-action="Index">Mesajlar</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg">
                    <h5>Bize Ulaşın</h5>
                    <partial name="_ContactInfo" />
                    <partial name="_SocialLinks" />
                </div>
            </div>
            <p class="copyright text-center py-3 mt-4 mb-0">Copyright &copy; @DateTime.Now.Year PetWalker | Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script>
        // Hover labels for icon-only buttons.
        // (data-tooltip is for buttons whose data-bs-toggle already opens a window.)
        for (const el of document.querySelectorAll('[data-bs-toggle="tooltip"], [data-tooltip]')) bootstrap.Tooltip.getOrCreateInstance(el);

        // Notifications close by themselves after 5 seconds.
        for (const alert of document.querySelectorAll('.toast-area .alert')) {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(alert).close(), 5000);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
